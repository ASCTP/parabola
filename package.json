{
  "name": "@asctp/parabola",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "TypeScript settlement kernel and operations layer for native USDC between Circle's Arc network and Stellar via CCTP V2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASCTP/parabola.git"
  },
  "bugs": {
    "url": "https://github.com/ASCTP/parabola/issues"
  },
  "homepage": "https://github.com/ASCTP/parabola#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "parabola": "./dist/cli-entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js",
      "require": "./dist/execution/index.cjs"
    },
    "./indexer": {
      "types": "./dist/indexer/index.d.ts",
      "import": "./dist/indexer/index.js",
      "require": "./dist/indexer/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.cjs"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js",
      "require": "./dist/observability.cjs"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js",
      "require": "./dist/conformance/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "require": "./dist/webhooks/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "verify:addresses": "node scripts/verify-contract-addresses.mjs",
    "smoke": "node scripts/testnet-smoke.mjs",
    "smoke:ops": "node scripts/testnet-ops-smoke.mjs",
    "dev:wallet-transfer-demo": "pnpm --filter wallet-transfer-demo dev"
  },
  "keywords": [
    "usdc",
    "cctp",
    "arc",
    "stellar",
    "circle",
    "cross-chain"
  ],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
